# =============================================================================
# EXPÉDITION D'E-MAILS TRANSACTIONNELS (Codes de confirmation OTP)
# Choisissez UNE des options ci-dessous :
# =============================================================================

# --- OPTION 1 : GMAIL (Gratuit et rapide avec mot de passe d'application) ---
# Activez la validation en 2 étapes sur votre compte Google, puis générez un mot de passe d'application :
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=mon-adresse@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="ECOGEST <mon-adresse@gmail.com>"

# --- OPTION 2 : BREVO / SENDINBLUE (Recommandé, 300 e-mails/jour gratuits) ---
# https://app.brevo.com/settings/keys/smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@domaine.com
# SMTP_PASS=votre_cle_smtp_brevo
# SMTP_FROM="ECOGEST <contact@votre-ecole.bj>"

# --- OPTION 3 : RESEND (HTTP API moderne sans port SMTP bloqué) ---
# https://resend.com/api-keys
# RESEND_API_KEY=re_123456789...
# EMAIL_FROM="ECOGEST <onboarding@resend.dev>"

